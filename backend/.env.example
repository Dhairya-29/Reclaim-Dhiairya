# Reclaim API settings. Copy this file to .env and fill in what you need:
#   cp .env.example .env
# .env is git-ignored, so keys stay on your machine. On Render, set the same names
# under the service's Environment tab instead (Render does not read this file).
# Run locally with:  uvicorn main:app --env-file .env --port 8000
#
# Lines starting with # use the built-in default. Uncomment a line only to change it:
# an empty value is not the same as unset (e.g. an empty ALLOWED_ORIGINS blocks every site).

# ---- Which AI model answers (first one set wins; none = safe built-in replies) ----
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Force one: claude | groq | ollama | rules
# RECLAIM_PROVIDER=

# Model names
# GROQ_MODEL=openai/gpt-oss-120b
# RECLAIM_MODEL=claude-opus-5-5
# OLLAMA_MODEL=qwen3.5:4b

# ---- Who may call the API (comma-separated; default * = anyone) ----
# ALLOWED_ORIGINS=https://reclaimyourself.netlify.app,http://localhost:5173

# ---- Safety ----
# Crisis numbers shown when someone may be in danger: India shows 112 and Tele MANAS 14416,
# anything else shows a generic "call your local emergency number".
# CRISIS_COUNTRY=India

# ---- Optional emotion classifier (needs: pip install -r requirements-ml.txt, ~1.5 GB RAM) ----
# EMOTION_CLASSIFIER_ENABLED=true
# EMOTION_MODEL=SamLowe/roberta-base-go_emotions

# ---- Files and logging ----
# IDEAS_PATH=../reclaim/ideas.json
# RECLAIM_DB=./reclaim.db
# LOG_LEVEL=INFO
